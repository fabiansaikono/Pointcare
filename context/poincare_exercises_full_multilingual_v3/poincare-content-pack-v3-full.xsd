<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="poincareContentPack">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" minOccurs="0" maxOccurs="1"/>
        <xs:element name="numberFormat" minOccurs="0" maxOccurs="1"/>
        <xs:element name="locales" minOccurs="0" maxOccurs="1"/>
        <xs:element name="grades" minOccurs="0" maxOccurs="1"/>
        <xs:element name="difficultyLevels" minOccurs="0" maxOccurs="1"/>
        <xs:element name="subcategories" minOccurs="0" maxOccurs="1"/>
        <xs:element name="exercises" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="poincareContentIndex">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" minOccurs="0" maxOccurs="1"/>
        <xs:element name="numberFormat" minOccurs="0" maxOccurs="1"/>
        <xs:element name="files" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
