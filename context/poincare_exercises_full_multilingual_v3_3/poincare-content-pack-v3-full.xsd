<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="poincareExercises">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" minOccurs="0" maxOccurs="1" type="xs:anyType"/>
        <xs:element name="subcategories" minOccurs="0" maxOccurs="1" type="xs:anyType"/>
        <xs:element name="exercises">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="exercise" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="prompts" type="xs:anyType"/>
                    <xs:element name="answers" type="xs:anyType"/>
                    <xs:element name="solution" minOccurs="1" maxOccurs="1" type="xs:anyType"/>
                  </xs:sequence>
                  <xs:attribute name="id" use="required" type="xs:string"/>
                  <xs:attribute name="progressKey" use="required" type="xs:string"/>
                  <xs:attribute name="mainCategory" use="required" type="xs:string"/>
                  <xs:attribute name="subCategory" use="required" type="xs:string"/>
                  <xs:attribute name="grade" use="required" type="xs:integer"/>
                  <xs:attribute name="difficultyStars" use="required" type="xs:integer"/>
                  <xs:attribute name="sequence" use="required" type="xs:string"/>
                  <xs:attribute name="type" use="required" type="xs:string"/>
                  <xs:attribute name="retryWhenWrong" use="required" type="xs:boolean"/>
                  <xs:attribute name="statusTracking" use="optional" type="xs:string"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" use="required" type="xs:string"/>
      <xs:attribute name="mainCategory" use="required" type="xs:string"/>
      <xs:attribute name="exerciseCount" use="required" type="xs:integer"/>
      <xs:attribute name="exercisesPerSubcategoryPerGrade" use="required" type="xs:integer"/>
      <xs:attribute name="excludedGeneratedSubcategories" use="optional" type="xs:string"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
