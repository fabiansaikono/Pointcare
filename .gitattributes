# Keep source text reviewable and deterministic across Windows and CI.
* text=auto eol=lf
*.bat text eol=crlf
*.md whitespace=-trailing-space

# Preserve third-party eSpeak runtime data byte-for-byte and keep it out of
# source whitespace checks; these files intentionally contain legacy spacing.
app/src/main/assets/tts/vits-piper-nl_BE-nathalie-medium/espeak-ng-data/** binary
*.md whitespace=-trailing-space

# Preserve third-party eSpeak runtime data byte-for-byte and keep it out of
# source whitespace checks; these files intentionally contain legacy spacing.
app/src/main/assets/tts/vits-piper-nl_BE-nathalie-medium/espeak-ng-data/** binary

# Store large binary application assets through Git LFS.
app/src/main/assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
app/src/main/assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
app/src/main/assets/**/*.onnx filter=lfs diff=lfs merge=lfs -text
app/src/main/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
app/src/main/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
